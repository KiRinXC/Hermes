<UserControl x:Class="Hermes.Windows.Apps.AppsCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Apps.CardButton" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="88"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Settings.CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Settings.ControlBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Effect" Value="{DynamicResource Settings.FocusGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="CatalogView" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,10">
                <ItemsControl x:Name="AppsItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Apps.CardButton}"
                                    Margin="0,0,0,12"
                                    Tag="{Binding Id}"
                                    Click="AppCard_Click"
                                    AutomationProperties.Name="{Binding Name}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42"
                                            Height="42"
                                            CornerRadius="10"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource Settings.ControlBrush}"
                                            BorderBrush="{DynamicResource Settings.BorderBrush}"
                                            BorderThickness="1">
                                        <Viewbox Width="22" Height="22">
                                            <Path Data="{Binding Icon}"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource Settings.AccentBrush}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{DynamicResource Settings.Label}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{DynamicResource Settings.Helper}"
                                                   Margin="0,5,8,0"/>
                                    </StackPanel>
                                    <Path Grid.Column="2"
                                          Width="7"
                                          Height="12"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource Settings.TextMutedBrush}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M0,0 L6,6 L0,12"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="DetailView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Settings.FaintDividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{DynamicResource Settings.GhostIconButton}"
                            MinWidth="72"
                            HorizontalAlignment="Left"
                            Click="Back_Click"
                            AutomationProperties.Name="返回应用列表">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="10"
                                  Height="10"
                                  Margin="0,0,8,0"
                                  Stroke="{DynamicResource Settings.TextMutedBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M8,0 L3,5 L8,10 M3,5 L12,5"/>
                            <TextBlock Text="返回"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="DetailTitle"
                               Grid.Column="1"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Style="{DynamicResource Settings.CardTitle}"/>
                </Grid>
            </Border>
            <ContentControl x:Name="DetailContent" Grid.Row="1"/>
        </Grid>
    </Grid>
</UserControl>
