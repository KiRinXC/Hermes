            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Button x:Name="TranslateButton"
                AutomationProperties.Name="翻译所选文本"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand"
                ToolTip="翻译所选文本"
                Click="TranslateButton_Click"
                MouseEnter="TranslateButton_MouseEnter"
                MouseLeave="TranslateButton_MouseLeave"
                PreviewMouseDown="TranslateButton_PreviewMouseDown"
                PreviewMouseUp="TranslateButton_PreviewMouseUp">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
