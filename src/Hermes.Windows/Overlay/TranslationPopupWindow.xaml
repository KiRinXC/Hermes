<Window x:Class="Hermes.Windows.Overlay.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        Height="260"
        MinWidth="280"
        MinHeight="180"
        MaxWidth="640"
        MaxHeight="720"
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Opacity="0">
    <Window.Resources>
        <Style x:Key="PopupActionButton" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseGlyphButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Path Width="10"
                                  Height="10"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 1 1 L 9 9 M 9 1 L 1 9"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Fill"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PinToggleButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Chrome"
                                Width="28"
                                Height="28"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <Path Width="13"
                                  Height="13"
                                  Fill="{TemplateBinding Foreground}"
                                  Data="M 7 0 L 13 6 L 10 7 L 7.5 9.5 L 7.5 13 L 6 13 L 6 9.5 L 3.5 7 L 0 6 L 6 0 Z"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SourcePanel}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Popup.ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Popup.ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Width="4"
                                Background="{DynamicResource Brush.ScrollThumb}"
                                CornerRadius="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Popup.ScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource Popup.ScrollBarPageButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource Popup.ScrollBarPageButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Popup.ScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Popup.ScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Margin="4,0,0,0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource Popup.ScrollBar}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card"
            CornerRadius="{StaticResource Radius.Overlay}"
            Background="{DynamicResource Brush.PopupSurface}"
            BorderBrush="{DynamicResource Brush.PopupBorder}"
            BorderThickness="1"
            Effect="{StaticResource Shadow.Overlay}"
            PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
            RenderTransformOrigin="0.5,0.1">
        <Border.RenderTransform>
            <TranslateTransform Y="10"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <Grid x:Name="DragSurface"
                  Grid.Row="0"
                  Margin="16,8,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="24"
                        Height="24"
                        CornerRadius="8"
                        Background="{DynamicResource Brush.SourcePanel}"
                        BorderBrush="{DynamicResource Brush.PopupBorder}"
                        BorderThickness="1"
                        Margin="0,0,10,0"
                        VerticalAlignment="Bottom">
                    <Image Source="../Resources/AppIcon.png"
                           Width="18"
                           Height="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <TextBlock x:Name="StateText"
                               Text="正在翻译..."
                               FontFamily="Segoe UI Variable Text, Segoe UI, PingFang SC, Microsoft YaHei UI"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Border x:Name="ProgressRail"
                            Height="1.5"
                            Margin="0,5,44,0"
                            ClipToBounds="True"
                            Opacity="1">
                        <Border Width="124"
                                Height="1.5"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.BrandGlow}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ProgressTransform" X="-124"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource CloseGlyphButton}"
                        ToolTip="关闭"
                        Click="CloseButton_Click"/>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="16,12,16,14"
                  MinHeight="86">
                <ScrollViewer x:Name="BodyScroll"
                              Style="{StaticResource Popup.ScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="420">
                    <StackPanel>
                        <TextBlock x:Name="BodyText"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, PingFang SC, Microsoft YaHei UI"
                                   FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   MinHeight="44"
                                   TextOptions.TextFormattingMode="Display">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="BodyTextTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <Border x:Name="SourceContainer"
                                Visibility="Collapsed"
                                CornerRadius="12"
                                Background="{DynamicResource Brush.SourcePanel}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="原文"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="SourcePreviewText"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="LongRunningPanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Path Width="28"
                          Height="28"
                          Stroke="{DynamicResource Brush.BrandGlow}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 14 2 A 12 12 0 1 1 4 20">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotateTransform" CenterX="14" CenterY="14"/>
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Text="翻译时间较长，请稍候..."
                               Margin="0,12,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextAlignment="Center"/>
                </StackPanel>

                <Grid x:Name="ErrorPanel"
                      Visibility="Collapsed"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Brush.Danger}"
                            CornerRadius="2"
                            Margin="0,2,0,2"/>
                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0">
                        <TextBlock x:Name="ErrorText"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource PopupActionButton}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Click="SettingsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="打开设置"
                                           FontSize="12"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="14,0,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="CopyButton"
                            Style="{StaticResource PopupActionButton}"
                            ToolTip="复制译文"
                            Click="CopyButton_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12"
                                  Height="12"
                                  Margin="0,0,6,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  Data="M 4 2 H 12 V 12 H 4 Z M 7 5 H 15 V 16 H 7 Z"
                                  Stretch="Uniform"/>
                            <TextBlock x:Name="CopyLabel" Text="复制译文"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RetryButton"
                            Style="{StaticResource PopupActionButton}"
                            ToolTip="重新翻译"
                            Click="RetryButton_Click"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12"
                                  Height="12"
                                  Margin="0,0,6,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 11 2 A 6 6 0 1 0 15 8 M 15 2 V 8 H 9"
                                  Stretch="Uniform"/>
                            <TextBlock Text="重新翻译"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ToggleButton x:Name="PinButton"
                              Grid.Column="1"
                              Style="{StaticResource PinToggleButton}"
                              ToolTip="固定卡片"
                              Click="PinButton_Click"
                              VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
