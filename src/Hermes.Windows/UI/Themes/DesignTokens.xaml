<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="Font.App">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>

    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.BodySmall">13</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Title">16</sys:Double>
    <sys:Double x:Key="FontSize.Heading">22</sys:Double>

    <Thickness x:Key="Space.2">2</Thickness>
    <Thickness x:Key="Space.4">4</Thickness>
    <Thickness x:Key="Space.8">8</Thickness>
    <Thickness x:Key="Space.12">12</Thickness>
    <Thickness x:Key="Space.16">16</Thickness>
    <Thickness x:Key="Space.20">20</Thickness>
    <Thickness x:Key="Space.24">24</Thickness>

    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.Surface">18</CornerRadius>
    <CornerRadius x:Key="Radius.Overlay">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <Duration x:Key="Motion.Fast">0:0:0.14</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.2</Duration>

    <DropShadowEffect x:Key="Shadow.Overlay" Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.15"/>
    <DropShadowEffect x:Key="Shadow.Floating" BlurRadius="24" ShadowDepth="8" Opacity="0.18"/>
    <DropShadowEffect x:Key="Shadow.Menu" BlurRadius="32" ShadowDepth="10" Opacity="0.18"/>
</ResourceDictionary>
