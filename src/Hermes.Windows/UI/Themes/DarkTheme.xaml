<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.App">#1C1C1E</Color>
    <Color x:Key="Color.Surface">#242426</Color>
    <Color x:Key="Color.SurfaceRaised">#2C2C2E</Color>
    <Color x:Key="Color.Overlay">#E01E1E20</Color>
    <Color x:Key="Color.TextPrimary">#F5F5F7</Color>
    <Color x:Key="Color.TextOnAccent">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#D1D1D6</Color>
    <Color x:Key="Color.TextMuted">#A1A1A6</Color>
    <Color x:Key="Color.Border">#1FFFFFFF</Color>
    <Color x:Key="Color.BorderStrong">#38FFFFFF</Color>
    <Color x:Key="Color.Accent">#0A84FF</Color>
    <Color x:Key="Color.AccentHover">#409CFF</Color>
    <Color x:Key="Color.AccentSoft">#260A84FF</Color>
    <Color x:Key="Color.Danger">#FF453A</Color>
    <Color x:Key="Color.Success">#32D74B</Color>
    <Color x:Key="Color.Focus">#0A84FF</Color>
    <Color x:Key="Color.Disabled">#636366</Color>
    <Color x:Key="Color.ButtonGlass">#D1202023</Color>
    <Color x:Key="Color.SourcePanel">#0FFFFFFF</Color>
    <Color x:Key="Color.TrayMenuSurface">#FF1C1C1E</Color>
    <Color x:Key="Color.PopupSurface">#D9121212</Color>
    <Color x:Key="Color.PopupBorderTop">#2C2C2E</Color>
    <Color x:Key="Color.PopupBorderBottom">#1C1C1E</Color>
    <Color x:Key="Color.BrandStart">#0A84FF</Color>
    <Color x:Key="Color.BrandEnd">#5E5CE6</Color>

    <SolidColorBrush x:Key="Brush.App" Color="{StaticResource Color.App}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="{StaticResource Color.TextOnAccent}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}"/>
    <SolidColorBrush x:Key="Brush.Disabled" Color="{StaticResource Color.Disabled}"/>
    <SolidColorBrush x:Key="Brush.ButtonGlass" Color="{StaticResource Color.ButtonGlass}"/>
    <SolidColorBrush x:Key="Brush.SourcePanel" Color="{StaticResource Color.SourcePanel}"/>
    <SolidColorBrush x:Key="Brush.TrayMenuSurface" Color="{StaticResource Color.TrayMenuSurface}"/>
    <SolidColorBrush x:Key="Brush.PopupSurface" Color="{StaticResource Color.PopupSurface}"/>
    <LinearGradientBrush x:Key="Brush.PopupBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.PopupBorderTop}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.PopupBorderBottom}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.BrandGlow" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource Color.BrandStart}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.BrandEnd}" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
