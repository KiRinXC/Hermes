<Window x:Class="Hermes.Windows.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="260"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown"
        Opacity="0">
    <Window.Resources>
        <Style x:Key="TrayMenu.Item" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SourcePanel}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource Brush.TrayMenuSurface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Surface}"
            Padding="8"
            Effect="{StaticResource Shadow.Menu}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
        </Border.RenderTransform>
        <StackPanel>
            <Grid Margin="6,6,6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="36"
                        Height="36"
                        CornerRadius="12"
                        Background="{DynamicResource Brush.ButtonGlass}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        Margin="0,0,10,0">
                    <Image Source="pack://application:,,,/Resources/AppIcon.png"
                           Width="28"
                           Height="28"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="Hermes"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock x:Name="StateText"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </Grid>

            <Button Style="{StaticResource TrayMenu.Item}"
                    Click="PauseResume_Click">
                <TextBlock x:Name="PauseText" FontSize="13"/>
            </Button>
            <Button Style="{StaticResource TrayMenu.Item}"
                    Click="TranslateClipboard_Click">
                <TextBlock Text="翻译剪贴板" FontSize="13"/>
            </Button>

            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="10,6"/>

            <Button Style="{StaticResource TrayMenu.Item}"
                    Click="Settings_Click">
                <TextBlock Text="设置" FontSize="13"/>
            </Button>
            <Button Style="{StaticResource TrayMenu.Item}"
                    Click="History_Click">
                <TextBlock Text="查看历史" FontSize="13"/>
            </Button>

            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="10,6"/>

            <Button Style="{StaticResource TrayMenu.Item}"
                    Click="Exit_Click">
                <TextBlock Text="退出 Hermes" FontSize="13"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
