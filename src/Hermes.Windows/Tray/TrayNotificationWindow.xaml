<Window x:Class="Hermes.Windows.Tray.TrayNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        Opacity="0">
    <Border x:Name="RootBorder"
            CornerRadius="{StaticResource Radius.Surface}"
            Background="{DynamicResource Brush.Overlay}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Padding="14"
            Effect="{StaticResource Shadow.Menu}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="42"
                    Height="42"
                    CornerRadius="14"
                    Background="{DynamicResource Brush.ButtonGlass}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Margin="0,0,12,0">
                <Image Source="pack://application:,,,/Resources/AppIcon.png"
                       Width="32"
                       Height="32"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MessageText"
                           Margin="0,4,0,0"
                           FontSize="12"
                           LineHeight="18"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Width="28"
                    Height="28"
                    Margin="10,-4,-4,0"
                    VerticalAlignment="Top"
                    Content="×"
                    Style="{StaticResource Button.TextAction}"
                    ToolTip="关闭"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
