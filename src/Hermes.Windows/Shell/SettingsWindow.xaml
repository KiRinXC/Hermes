<Window x:Class="Hermes.Windows.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes 设置"
        Width="800"
        Height="600"
        MinWidth="720"
        MinHeight="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="../Resources/AppIcon.ico"
        FontFamily="{StaticResource AppFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Opacity="0"
        Loaded="Window_Loaded"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Settings.ShellBrush" Color="#F20A0A0C"/>
        <SolidColorBrush x:Key="Settings.TextPrimaryBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Settings.TextSecondaryBrush" Color="#FFD1D1D6"/>
        <SolidColorBrush x:Key="Settings.TextMutedBrush" Color="#FF8E8E93"/>
        <SolidColorBrush x:Key="Settings.CardBrush" Color="#08FFFFFF"/>
        <SolidColorBrush x:Key="Settings.ControlBrush" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="Settings.ControlStrongBrush" Color="#33000000"/>
        <SolidColorBrush x:Key="Settings.BorderBrush" Color="#FF2C2C2E"/>
        <SolidColorBrush x:Key="Settings.DividerBrush" Color="#142C2C2E"/>
        <SolidColorBrush x:Key="Settings.FaintDividerBrush" Color="#05FFFFFF"/>
        <SolidColorBrush x:Key="Settings.AccentBrush" Color="#FF007AFF"/>
        <SolidColorBrush x:Key="Settings.SuccessBrush" Color="#FF30D158"/>
        <SolidColorBrush x:Key="Settings.WarningBrush" Color="#FFFFB74D"/>
        <SolidColorBrush x:Key="Settings.BlueSoftBrush" Color="#FF64B5F6"/>
        <SolidColorBrush x:Key="Settings.KeycapBrush" Color="#FF1B1B1F"/>
        <SolidColorBrush x:Key="Settings.KeycapBorderBrush" Color="#FF2C2C2E"/>
        <SolidColorBrush x:Key="Settings.ToggleTrackBrush" Color="#FF2C2C2E"/>
        <SolidColorBrush x:Key="Settings.SliderTrackBrush" Color="#FF2C2C2E"/>
        <SolidColorBrush x:Key="Settings.SliderThumbBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Settings.FloatingButtonPreviewOuterBrush" Color="#FF000000"/>
        <SolidColorBrush x:Key="Settings.FloatingButtonPreviewInnerBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Settings.ScrollBarThumbBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="Settings.ScrollBarThumbHoverBrush" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Settings.SegmentTrackBrush" Color="#14000000"/>
        <SolidColorBrush x:Key="Settings.SegmentIndicatorBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="Settings.SegmentIndicatorBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="Settings.KeycapShellBrush" Color="#33000000"/>

        <LinearGradientBrush x:Key="Settings.OuterStrokeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF2C2C30" Offset="0"/>
            <GradientStop Color="#FF1A1A1E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Settings.AccentGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#FF007AFF" Offset="0"/>
            <GradientStop Color="#FF5856D6" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="Settings.ShellShadow" Color="#000000" BlurRadius="36" ShadowDepth="10" Opacity="0.38"/>
        <DropShadowEffect x:Key="Settings.FocusGlow" Color="#007AFF" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>

        <Style x:Key="Settings.WindowButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.FooterButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Settings.KeycapBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.KeycapBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="Highlight"
                                        CornerRadius="16"
                                        Opacity="0"
                                        Background="#20FFFFFF"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="1"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource Settings.FocusGlow}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Settings.FooterButton}">
            <Setter Property="MinWidth" Value="124"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource Settings.AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#FF1888FF"/>
        </Style>

        <Style x:Key="Settings.GhostIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Settings.FooterButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource Settings.KeycapBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.KeycapBorderBrush}"/>
        </Style>

        <Style x:Key="Settings.ApiTestButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Settings.GhostIconButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="102"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Settings.KeycapButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Background" Value="{DynamicResource Settings.KeycapShellBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.KeycapBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Settings.KeycapBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource Settings.FocusGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.GroupCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Settings.CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="Settings.CardTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="Settings.Label" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Settings.Helper" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

        <Style x:Key="Settings.Row" TargetType="{x:Type Border}">
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.FaintDividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="Settings.TextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Settings.ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Settings.AccentBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.KeycapBorderBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Settings.ControlStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Settings.ControlStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.PasswordBox" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,4,38,4"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Settings.ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Settings.AccentBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.KeycapBorderBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Settings.ControlStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Settings.ControlStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.ComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Settings.ControlBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Settings.ControlStrongBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.ComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Settings.ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Settings.ComboBoxItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="{TemplateBinding Padding}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource Settings.TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource Settings.TextPrimaryBrush}"
                                     VerticalContentAlignment="Center"
                                     Visibility="Hidden"
                                     Focusable="True"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              IsHitTestVisible="False"/>
                            <Path Width="8"
                                  Height="5"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Data="M 0 0 L 4 5 L 8 0"
                                  Stroke="{DynamicResource Settings.TextMutedBrush}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="None"
                                  IsHitTestVisible="False"/>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,6,0,0"
                                        Background="{DynamicResource Settings.ShellBrush}"
                                        BorderBrush="{DynamicResource Settings.BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4"
                                        Effect="{StaticResource Settings.ShellShadow}">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_EditableTextBox" Property="IsHitTestVisible" Value="True"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="DropDownToggle" Property="Width" Value="32"/>
                                <Setter TargetName="DropDownToggle" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.KeycapBorderBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Settings.ControlStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Settings.AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Settings.ControlStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.ToggleSwitch" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource Settings.ToggleTrackBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Settings.BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="FocusRing"
                                    CornerRadius="13"
                                    BorderBrush="{DynamicResource Settings.AccentBrush}"
                                    BorderThickness="0"/>
                            <Border x:Name="Track"
                                    Margin="1"
                                    CornerRadius="12"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"/>
                            <Border x:Name="Thumb"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="{DynamicResource Settings.SliderThumbBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.22"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Settings.AccentGradientBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Settings.AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="20"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.48"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.Tabs" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="24,12,24,0"
                                      HorizontalAlignment="Left"
                                      KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1"
                                    BorderBrush="{DynamicResource Settings.DividerBrush}"
                                    BorderThickness="0,1,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Top"
                                              Margin="0,1,0,0"/>
                            <Border x:Name="Indicator"
                                    Height="2"
                                    Width="42"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="1"
                                    Opacity="0"
                                    Background="{DynamicResource Settings.AccentGradientBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="IndicatorScale" ScaleX="0.35"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.35"
                                                             To="1"
                                                             Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.SliderTrackButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="3"
                                CornerRadius="2"
                                Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.SliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Width="12"
                                Height="12"
                                CornerRadius="6"
                                Background="{DynamicResource Settings.SliderThumbBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.18"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.Slider" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="{DynamicResource Settings.AccentBrush}"
                                                  Style="{StaticResource Settings.SliderTrackButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="{DynamicResource Settings.SliderTrackBrush}"
                                                  Style="{StaticResource Settings.SliderTrackButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Settings.SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.SegmentRadio" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource Settings.TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Settings.TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.IconSizeDotButton" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Dot"
                                     Width="9"
                                     Height="9"
                                     Fill="{DynamicResource Settings.SliderTrackBrush}"
                                     Stroke="{DynamicResource Settings.KeycapBorderBrush}"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                            <Ellipse x:Name="FocusRing"
                                     Width="22"
                                     Height="22"
                                     Stroke="{DynamicResource Settings.AccentBrush}"
                                     StrokeThickness="1"
                                     Opacity="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Settings.KeycapBrush}"/>
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Settings.AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="14"/>
                                <Setter TargetName="Dot" Property="Height" Value="14"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Settings.AccentBrush}"/>
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Settings.AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome"
                                Background="{DynamicResource Settings.ScrollBarThumbBrush}"
                                CornerRadius="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Settings.ScrollBarThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Settings.ScrollBarThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Settings.ScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootShell"
            Margin="0"
            CornerRadius="14"
            Background="{DynamicResource Settings.ShellBrush}"
            ClipToBounds="True"
            SizeChanged="RootShell_SizeChanged"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootShellScaleTransform" ScaleX="0.95" ScaleY="0.95"/>
        </Border.RenderTransform>
        <Border CornerRadius="14"
                Background="{DynamicResource Settings.ShellBrush}">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,2,10,0">
                        <Button Style="{StaticResource Settings.WindowButton}"
                                AutomationProperties.Name="关闭"
                                Click="Close_Click">
                            <Path Width="11"
                                  Height="11"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource Settings.TextMutedBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M0,0 L11,11 M11,0 L0,11"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="42" Height="36" Margin="0,0,18,0">
                        <Border Width="36"
                                Height="36"
                                CornerRadius="12"
                                Background="{DynamicResource Settings.AccentGradientBrush}"
                                Opacity="0.10"/>
                        <Border Width="36"
                                Height="36"
                                CornerRadius="8"
                                Background="#12FFFFFF"
                                BorderBrush="#1EFFFFFF"
                                BorderThickness="1">
                            <Image Source="../Resources/AppIcon.png"
                                   Width="27"
                                   Height="27"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Hermes"
                                   Foreground="{DynamicResource Settings.TextPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="Medium"/>
                    </StackPanel>

                    <Button x:Name="HeaderHotkeyButton"
                            Grid.Column="2"
                            Style="{StaticResource Settings.KeycapButton}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="设置划词翻译快捷键"
                            ToolTip="点击后按新的快捷键组合"
                            Click="HeaderHotkeyButton_Click"
                            PreviewKeyDown="HotkeyRecorder_PreviewKeyDown"
                            LostKeyboardFocus="HotkeyRecorder_LostKeyboardFocus">
                        <StackPanel x:Name="HeaderHotkeyKeys"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <TabControl x:Name="SettingsTabs"
                            Grid.Row="2"
                            Grid.RowSpan="2"
                            SelectionChanged="SettingsTabs_SelectionChanged"
                            Style="{StaticResource Settings.Tabs}">
                    <TabItem Header="常规">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,18,24,10">
                                <Border Style="{StaticResource Settings.GroupCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource Settings.Row}">
                                            <DockPanel LastChildFill="True">
                                                <ToggleButton x:Name="AutoButtonCheck"
                                                              DockPanel.Dock="Right"
                                                              Style="{StaticResource Settings.ToggleSwitch}"
                                                              Margin="18,0,0,0"
                                                              AutomationProperties.Name="启用全局划词翻译"/>
                                                <TextBlock Text="启用全局划词翻译" Style="{StaticResource Settings.Label}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource Settings.Row}">
                                            <DockPanel LastChildFill="True">
                                                <ToggleButton x:Name="StartupCheck"
                                                              DockPanel.Dock="Right"
                                                              Style="{StaticResource Settings.ToggleSwitch}"
                                                              Margin="18,0,0,0"
                                                              AutomationProperties.Name="开机时自动启动 Hermes"/>
                                                <TextBlock Text="开机时自动启动 Hermes" Style="{StaticResource Settings.Label}"/>
                                            </DockPanel>
                                        </Border>

                                        <Border Style="{StaticResource Settings.Row}">
                                            <DockPanel LastChildFill="True">
                                                <ToggleButton x:Name="SaveHistoryCheck"
                                                              DockPanel.Dock="Right"
                                                              Style="{StaticResource Settings.ToggleSwitch}"
                                                              Margin="18,0,0,0"
                                                              AutomationProperties.Name="保存翻译历史"/>
                                                <StackPanel>
                                                    <TextBlock Text="保存翻译历史" Style="{StaticResource Settings.Label}"/>
                                                    <TextBlock Text="仅保存在本机，默认关闭。"
                                                               Style="{StaticResource Settings.Helper}"
                                                               Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource Settings.Row}" BorderThickness="0">
                                            <DockPanel LastChildFill="True">
                                                <ToggleButton x:Name="SaveOriginalCheck"
                                                              DockPanel.Dock="Right"
                                                              Style="{StaticResource Settings.ToggleSwitch}"
                                                              Margin="18,0,0,0"
                                                              AutomationProperties.Name="保存历史时包含原文"/>
                                                <TextBlock Text="保存历史时包含原文" Style="{StaticResource Settings.Label}"/>
                                            </DockPanel>
                                        </Border>

                                        <Border CornerRadius="9"
                                                Background="#0AFFFFFF"
                                                BorderBrush="#12FFFFFF"
                                                BorderThickness="1"
                                                Padding="12"
                                                Margin="0,14,0,0">
                                            <DockPanel>
                                                <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0,1,12,0">
                                                    <Path Stroke="{DynamicResource Settings.TextMutedBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M3,7 L3,4.8 C3,2.6 4.8,1 7,1 C9.2,1 11,2.6 11,4.8 L11,7 M2,7 L12,7 L12,13 L2,13 Z M7,9 L7,11"/>
                                                </Viewbox>
                                                <TextBlock Text="Hermes 不上传未主动触发的文本，日志不记录 API Key、完整原文或译文。"
                                                           Style="{StaticResource Settings.Helper}"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Settings.GroupCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="软件更新" Style="{StaticResource Settings.Label}"/>
                                            <TextBlock x:Name="UpdateStatusText"
                                                       Margin="0,5,16,0"
                                                       Style="{StaticResource Settings.Helper}"
                                                       AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                        <Button x:Name="UpdateActionButton"
                                                Grid.Column="1"
                                                Width="112"
                                                MinWidth="112"
                                                Height="36"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Settings.ApiTestButton}"
                                                Click="UpdateAction_Click"
                                                AutomationProperties.Name="检查软件更新">
                                            <Grid MinWidth="86">
                                                <StackPanel x:Name="UpdateCheckContent"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Viewbox Width="12" Height="12" Margin="0,0,9,0">
                                                        <Path Stroke="{DynamicResource Settings.TextMutedBrush}"
                                                              StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Data="M12,3 L12,7 L8,7 M12,7 C11,4.2 8.5,2 5.8,2 C2.6,2 0,4.6 0,7.8 C0,11 2.6,13.6 5.8,13.6 C7.7,13.6 9.3,12.8 10.4,11.5"/>
                                                    </Viewbox>
                                                    <TextBlock x:Name="UpdateCheckButtonText" Text="检查更新"/>
                                                </StackPanel>
                                                <StackPanel x:Name="UpdateInstallContent"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            Visibility="Collapsed">
                                                    <Path Width="13"
                                                          Height="13"
                                                          Margin="0,0,9,0"
                                                          Stretch="Uniform"
                                                          Stroke="#FFFFFFFF"
                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M6.5,0 L6.5,8 M2.8,4.8 L6.5,8.5 L10.2,4.8 M1,12 L12,12"/>
                                                    <TextBlock Text="更新"/>
                                                </StackPanel>
                                                <StackPanel x:Name="UpdateBusyContent"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            Visibility="Collapsed">
                                                    <Path x:Name="UpdateActionSpinnerPath"
                                                          Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Data="M7,0.8 A6.2,6.2 0 1 1 2.1,11.2"
                                                          Stroke="{DynamicResource Settings.BlueSoftBrush}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Stretch="None">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="UpdateActionSpinnerRotate"
                                                                             CenterX="7"
                                                                             CenterY="7"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <TextBlock x:Name="UpdateBusyButtonText" Text="检查中..."/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="翻译">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,18,24,10">
                                <Border Style="{StaticResource Settings.GroupCard}">
                                    <StackPanel>
                                        <TextBlock Text="AI 翻译" Style="{StaticResource Settings.CardTitle}"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="128"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="44"/>
                                                <RowDefinition Height="44"/>
                                                <RowDefinition Height="44"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" Style="{StaticResource Settings.Label}"/>
                                            <TextBox Grid.Row="0"
                                                     Grid.Column="1"
                                                     Grid.ColumnSpan="4"
                                                     Height="36"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource Settings.TextBox}"
                                                     Text="Tencent Transmart"
                                                     Padding="10,4"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL" Style="{StaticResource Settings.Label}"/>
                                            <TextBox x:Name="TransmartBaseUrlText"
                                                     Grid.Row="1"
                                                     Grid.Column="1"
                                                     Grid.ColumnSpan="4"
                                                     Height="36"
                                                     Style="{StaticResource Settings.TextBox}"
                                                     Padding="10,4"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" Style="{StaticResource Settings.Label}"/>
                                            <TextBox x:Name="TransmartModelText"
                                                     Grid.Row="2"
                                                     Grid.Column="1"
                                                     Grid.ColumnSpan="4"
                                                     Height="36"
                                                     Style="{StaticResource Settings.TextBox}"
                                                     Padding="10,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Settings.GroupCard}">
                                    <StackPanel>
                                        <TextBlock Text="AI 解释" Style="{StaticResource Settings.CardTitle}"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="44"/>
                                                <RowDefinition Height="44"/>
                                                <RowDefinition Height="44"/>
                                                <RowDefinition Height="44"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" Style="{StaticResource Settings.Label}"/>
                                            <TextBox Grid.Row="0"
                                                     Grid.Column="1"
                                                     Grid.ColumnSpan="4"
                                                     Height="36"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource Settings.TextBox}"
                                                     Text="OpenAI / OpenAI-compatible"
                                                     Padding="10,4"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL" Style="{StaticResource Settings.Label}"/>
                                            <TextBox x:Name="OpenAiBaseUrlText"
                                                     Grid.Row="1"
                                                     Grid.Column="1"
                                                     Grid.ColumnSpan="3"
                                                     Height="36"
                                                     Style="{StaticResource Settings.TextBox}"
                                                     Padding="10,4"/>
                                            <StackPanel Grid.Row="1"
                                                        Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="翻译也使用 OpenAI"
                                                           Style="{StaticResource Settings.Label}"
                                                           FontSize="12"
                                                           Margin="0,0,10,0"/>
                                                <ToggleButton x:Name="OpenAiForTranslationCheck"
                                                              Style="{StaticResource Settings.ToggleSwitch}"
                                                              Checked="OpenAiForTranslationCheck_Changed"
                                                              Unchecked="OpenAiForTranslationCheck_Changed"
                                                              AutomationProperties.Name="翻译也使用 OpenAI"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" Style="{StaticResource Settings.Label}"/>
                                            <TextBox x:Name="OpenAiModelText"
                                                     Grid.Row="2"
                                                     Grid.Column="1"
                                                     Grid.ColumnSpan="4"
                                                     Height="36"
                                                     Style="{StaticResource Settings.TextBox}"
                                                     Padding="10,4"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="API Key" Style="{StaticResource Settings.Label}"/>
                                            <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3">
                                                <PasswordBox x:Name="ApiKeyBox"
                                                             Height="36"
                                                             Style="{StaticResource Settings.PasswordBox}"
                                                             Padding="10,4,38,4"/>
                                                <TextBox x:Name="ApiKeyRevealText"
                                                         Height="36"
                                                         Style="{StaticResource Settings.TextBox}"
                                                         Padding="10,4,38,4"
                                                         Visibility="Collapsed"/>
                                                <Button x:Name="ApiKeyRevealButton"
                                                        Width="30"
                                                        Height="30"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,2,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="ApiKeyReveal_Click"
                                                        AutomationProperties.Name="显示或隐藏 API Key">
                                                    <Path Width="16"
                                                          Height="11"
                                                          Stretch="Fill"
                                                          Stroke="{DynamicResource Settings.TextMutedBrush}"
                                                          StrokeThickness="1.2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Data="M0,5.5 C2.2,1.8 5,0 8,0 C11,0 13.8,1.8 16,5.5 C13.8,9.2 11,11 8,11 C5,11 2.2,9.2 0,5.5 M8,3.2 A2.3,2.3 0 1 1 8,7.8 A2.3,2.3 0 1 1 8,3.2"/>
                                                </Button>
                                            </Grid>
                                            <Button x:Name="TestButton"
                                                    Grid.Row="3" Grid.Column="4"
                                                    Style="{StaticResource Settings.ApiTestButton}"
                                                    HorizontalAlignment="Right"
                                                    Width="112"
