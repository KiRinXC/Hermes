<Window x:Class="Hermes.Windows.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes 设置"
        Width="760"
        Height="720"
        MinWidth="660"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="../Resources/AppIcon.ico"
        FontFamily="{StaticResource AppFont}"
        Background="{DynamicResource Brush.App}">
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Brush.Overlay}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Surface}"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Chrome"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SourcePanel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.ButtonGlass}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="28">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="44"
                    Height="44"
                    CornerRadius="14"
                    Background="{DynamicResource Brush.ButtonGlass}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Margin="0,0,14,0">
                <Image Source="../Resources/AppIcon.png"
                       Width="34"
                       Height="34"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Hermes"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock Text="按住 Ctrl 选中英文，旁边出现悬浮图标，点一下得到中文结果。"
                           Style="{StaticResource Text.Helper}"
                           Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="2"
                    Style="{StaticResource Status.Pill}"
                    VerticalAlignment="Center">
                <TextBlock Text="Ctrl + Alt + E"
                           Foreground="{DynamicResource Brush.Accent}"
                           FontWeight="SemiBold"
                           FontSize="12"/>
            </Border>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource Brush.Accent}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestButton"
                        Content="测试连接"
                        Style="{StaticResource Button.Command}"
                        Width="104"
                        Click="TestConnection_Click"/>
                <Button x:Name="ClearHistoryButton"
                        Content="清空历史"
                        Style="{StaticResource Button.Command}"
                        Width="104"
                        Margin="8,0,0,0"
                        Click="ClearHistory_Click"/>
                <Button x:Name="SaveButton"
                        Content="保存"
                        Style="{StaticResource Button.Primary}"
                        Width="104"
                        Margin="8,0,0,0"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>

        <TabControl>
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="常规" Style="{StaticResource Text.SectionTitle}"/>
                                <Border Style="{StaticResource Settings.Row}">
                                    <DockPanel>
                                        <ToggleButton x:Name="AutoButtonCheck"
                                                      DockPanel.Dock="Right"
                                                      Style="{StaticResource Toggle.Switch}"
                                                      AutomationProperties.Name="启用划词翻译"/>
                                        <TextBlock Text="启用划词翻译" Style="{StaticResource SettingLabel}"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Settings.Row}">
                                    <DockPanel>
                                        <ToggleButton x:Name="StartupCheck"
                                                      DockPanel.Dock="Right"
                                                      Style="{StaticResource Toggle.Switch}"
                                                      AutomationProperties.Name="开机自动启动"/>
                                        <TextBlock Text="开机自动启动" Style="{StaticResource SettingLabel}"/>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="平时保持隐藏。只有按住 Ctrl 选中文本后点击悬浮图标、按快捷键或通过托盘菜单触发时，文本才会发送给 AI。"
                                           Style="{StaticResource Text.Helper}"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="翻译">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="API" Style="{StaticResource Text.SectionTitle}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox x:Name="ProviderCombo" Grid.Row="0" Grid.Column="1" Margin="0,6">
                                        <ComboBoxItem Content="OpenAI"/>
                                        <ComboBoxItem Content="OpenAI-compatible"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL" Style="{StaticResource SettingLabel}"/>
                                    <TextBox x:Name="BaseUrlText" Grid.Row="1" Grid.Column="1" Margin="0,6"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key" Style="{StaticResource SettingLabel}"/>
                                    <PasswordBox x:Name="ApiKeyBox" Grid.Row="2" Grid.Column="1" Margin="0,6"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Model" Style="{StaticResource SettingLabel}"/>
                                    <TextBox x:Name="ModelText" Grid.Row="3" Grid.Column="1" Margin="0,6"/>
                                </Grid>
                                <TextBlock x:Name="ApiKeyStatusText" Style="{StaticResource Text.Helper}" Margin="150,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="翻译偏好" Style="{StaticResource Text.SectionTitle}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="目标语言" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="简体中文" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="翻译风格" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox x:Name="StyleCombo" Grid.Row="1" Grid.Column="1" Margin="0,6">
                                        <ComboBoxItem Content="natural"/>
                                        <ComboBoxItem Content="literal"/>
                                        <ComboBoxItem Content="professional"/>
                                        <ComboBoxItem Content="concise"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="最大文本长度" Style="{StaticResource SettingLabel}"/>
                                    <TextBox x:Name="MaxCharsText" Grid.Row="2" Grid.Column="1" Margin="0,6"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="保留格式" Style="{StaticResource SettingLabel}"/>
                                    <ToggleButton x:Name="PreserveFormatCheck"
                                                  Grid.Row="3"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Left"
                                                  Style="{StaticResource Toggle.Switch}"
                                                  AutomationProperties.Name="保留原文段落和基本格式"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="快捷键" Style="{StaticResource Text.SectionTitle}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="划词翻译快捷键" Style="{StaticResource SettingLabel}"/>
                                    <TextBox x:Name="HotkeyText" Grid.Column="1" Margin="0,6"/>
                                </Grid>
                                <TextBlock Text="如果某些应用无法读取选区，快捷键会使用受控剪贴板兜底。"
                                           Style="{StaticResource Text.Helper}"
                                           Margin="150,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="外观" Style="{StaticResource Text.SectionTitle}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="主题" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox x:Name="ThemeCombo" Grid.Row="0" Grid.Column="1" Margin="0,6">
                                        <ComboBoxItem Content="System"/>
                                        <ComboBoxItem Content="Light"/>
                                        <ComboBoxItem Content="Dark"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="卡片宽度" Style="{StaticResource SettingLabel}"/>
                                    <TextBox x:Name="PopupWidthText" Grid.Row="1" Grid.Column="1" Margin="0,6"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="译文字号" Style="{StaticResource SettingLabel}"/>
                                    <TextBox x:Name="FontSizeText" Grid.Row="2" Grid.Column="1" Margin="0,6"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="卡片透明度" Style="{StaticResource SettingLabel}"/>
                                    <TextBox x:Name="OpacityText" Grid.Row="3" Grid.Column="1" Margin="0,6"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="隐私">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="隐私" Style="{StaticResource Text.SectionTitle}"/>
                                <TextBlock Text="只有在你点击悬浮图标或按下快捷键后，文本才会发送给 AI。"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,12"/>
                                <Border Style="{StaticResource Settings.Row}">
                                    <DockPanel>
                                        <ToggleButton x:Name="SaveHistoryCheck"
                                                      DockPanel.Dock="Right"
                                                      Style="{StaticResource Toggle.Switch}"
                                                      AutomationProperties.Name="保存翻译历史"/>
                                        <TextBlock Text="保存翻译历史" Style="{StaticResource SettingLabel}"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Settings.Row}">
                                    <DockPanel>
                                        <ToggleButton x:Name="SaveOriginalCheck"
                                                      DockPanel.Dock="Right"
                                                      Style="{StaticResource Toggle.Switch}"
                                                      AutomationProperties.Name="保存历史时包含原文"/>
                                        <TextBlock Text="保存历史时包含原文" Style="{StaticResource SettingLabel}"/>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="敏感应用和密码控件会禁用自动读取，剪贴板兜底只在用户主动点击或按快捷键后执行。"
                                           Style="{StaticResource Text.Helper}"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="高级">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="最近触发诊断" Style="{StaticResource Text.SectionTitle}"/>
                                        <TextBlock Text="用于检查划词按钮为何出现或被抑制，不记录选中文本。"
                                                   Style="{StaticResource Text.Helper}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="刷新"
                                            Style="{StaticResource Button.Command}"
                                            Click="RefreshDiagnostics_Click"/>
                                </DockPanel>

                                <ItemsControl x:Name="DiagnosticsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.SourcePanel}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Decision}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ProcessName, TargetNullValue=未知应用}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Reason}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="DiagnosticsEmptyText" Text="暂无触发记录。" Style="{StaticResource Text.Helper}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
