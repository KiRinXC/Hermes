                                                    </Viewbox>
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="浮窗字号" Style="{StaticResource Settings.Label}"/>
                                            <Grid Grid.Row="2"
                                                  Grid.Column="1"
                                                  Grid.ColumnSpan="2"
                                                  Height="36"
                                                  VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid x:Name="PopupFontSizeSmallPreview"
                                                      Width="34"
                                                      Height="34"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False">
                                                    <Viewbox Width="12"
                                                             Height="12"
                                                             Stretch="Uniform"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M4 20 L12 4 L20 20 M7.5 14 H16.5"
                                                                  Stroke="{DynamicResource Settings.TextMutedBrush}"
                                                                  StrokeThickness="2.25"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>

                                                <Grid Grid.Column="1"
                                                      Margin="6,0"
                                                      VerticalAlignment="Center">
                                                    <Border x:Name="PopupFontSizeTrack"
                                                            Height="2"
                                                            Background="{DynamicResource Settings.SliderTrackBrush}"
                                                            CornerRadius="1"
                                                            VerticalAlignment="Center"
                                                            Margin="14,0"/>
                                                    <UniformGrid x:Name="PopupFontSizeDots"
                                                                 Columns="5"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Center">
                                                        <RadioButton Tag="12"
                                                                     GroupName="PopupFontSize"
                                                                     Style="{StaticResource Settings.IconSizeDotButton}"
                                                                     Checked="PopupFontSizeDot_Checked"
                                                                     AutomationProperties.Name="12 磅浮窗字号"/>
                                                        <RadioButton Tag="14"
                                                                     GroupName="PopupFontSize"
                                                                     Style="{StaticResource Settings.IconSizeDotButton}"
                                                                     Checked="PopupFontSizeDot_Checked"
                                                                     AutomationProperties.Name="14 磅浮窗字号"/>
                                                        <RadioButton Tag="16"
                                                                     GroupName="PopupFontSize"
                                                                     Style="{StaticResource Settings.IconSizeDotButton}"
                                                                     Checked="PopupFontSizeDot_Checked"
                                                                     AutomationProperties.Name="16 磅浮窗字号"/>
                                                        <RadioButton Tag="18"
                                                                     GroupName="PopupFontSize"
                                                                     Style="{StaticResource Settings.IconSizeDotButton}"
                                                                     Checked="PopupFontSizeDot_Checked"
                                                                     AutomationProperties.Name="18 磅浮窗字号"/>
                                                        <RadioButton Tag="20"
                                                                     GroupName="PopupFontSize"
                                                                     Style="{StaticResource Settings.IconSizeDotButton}"
                                                                     Checked="PopupFontSizeDot_Checked"
                                                                     AutomationProperties.Name="20 磅浮窗字号"/>
                                                    </UniformGrid>
                                                </Grid>

                                                <Grid x:Name="PopupFontSizeLargePreview"
                                                      Grid.Column="2"
                                                      Width="34"
                                                      Height="34"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False">
                                                    <Viewbox Width="20"
                                                             Height="20"
                                                             Stretch="Uniform"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M4 20 L12 4 L20 20 M7.5 14 H16.5"
                                                                  Stroke="{DynamicResource Settings.TextPrimaryBrush}"
                                                                  StrokeThickness="2.25"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="卡片透明度" Style="{StaticResource Settings.Label}"/>
                                            <Slider x:Name="OpacitySlider"
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Minimum="0.75"
                                                    Maximum="1"
                                                    TickFrequency="0.01"
                                                    Style="{StaticResource Settings.Slider}"
                                                    ValueChanged="AppearanceSlider_ValueChanged"/>
                                            <TextBlock x:Name="OpacityValueText"
                                                       Grid.Row="3"
                                                       Grid.Column="2"
                                                       Foreground="{DynamicResource Settings.TextMutedBrush}"
                                                       FontSize="12"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="高级">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,18,24,10">
                                <Border Style="{StaticResource Settings.GroupCard}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button x:Name="AdvancedClearHistoryButton"
                                                        Style="{StaticResource Settings.GhostIconButton}"
                                                        Click="ClearHistory_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="12" Height="12" Margin="0,0,10,0">
                                                            <Path Stroke="{DynamicResource Settings.TextMutedBrush}"
                                                                  StrokeThickness="1.4"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Data="M2,4 L12,4 M5,4 L5,2 L9,2 L9,4 M4,4 L4.6,13 L9.4,13 L10,4 M6,6 L6.2,11 M8,6 L7.8,11"/>
                                                        </Viewbox>
                                                        <TextBlock Text="清空记录"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource Settings.GhostIconButton}"
                                                        Margin="8,0,0,0"
                                                        Click="RefreshDiagnostics_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="12" Height="12" Margin="0,0,10,0">
                                                            <Path Stroke="{DynamicResource Settings.TextMutedBrush}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Data="M12,3 L12,7 L8,7 M12,7 C11,4.2 8.5,2 5.8,2 C2.6,2 0,4.6 0,7.8 C0,11 2.6,13.6 5.8,13.6 C7.7,13.6 9.3,12.8 10.4,11.5"/>
                                                        </Viewbox>
                                                        <TextBlock Text="刷新列表"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="最近触发诊断" Style="{StaticResource Settings.CardTitle}"/>
                                                <TextBlock Text="记录触发原因，不记录选中文本。"
                                                           Style="{StaticResource Settings.Helper}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <ItemsControl x:Name="DiagnosticsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MinHeight="36"
                                                            BorderBrush="{DynamicResource Settings.FaintDividerBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                                       Foreground="#FF666666"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Decision}"
                                                                       Foreground="{DynamicResource Settings.TextMutedBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="{x:Type TextBlock}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Settings.TextMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Decision}" Value="button-shown">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Settings.BlueSoftBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Decision}" Value="suppressed">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Settings.WarningBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding ProcessName, TargetNullValue=未知应用}"
                                                                       Foreground="{DynamicResource Settings.TextPrimaryBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="Medium"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Reason}"
                                                                       Foreground="{DynamicResource Settings.TextMutedBrush}"
                                                                       FontSize="12"
                                                                       TextAlignment="Right"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="DiagnosticsEmptyText"
                                                   Text="暂无触发记录。"
                                                   Style="{StaticResource Settings.Helper}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="应用">
                        <ContentControl x:Name="AppsHost"/>
                    </TabItem>
                </TabControl>

                <Border Grid.Row="4"
                        BorderBrush="{DynamicResource Settings.BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="StatusText"
                                   Grid.Column="0"
                                   Foreground="{DynamicResource Settings.TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   MaxHeight="34"/>

                        <Button x:Name="SaveButton"
                                Grid.Column="1"
                                Style="{StaticResource Settings.PrimaryButton}"
                                Click="Save_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13"
                                      Height="10"
                                      Margin="0,0,10,0"
                                      Stroke="#FFFFFFFF"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M0,5 L4.2,9 L13,0"/>
                                <TextBlock Text="确定保存"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="ConfirmationOverlay"
                        Grid.RowSpan="5"
                        Panel.ZIndex="1000"
                        Background="#8A000000"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Hermes 操作确认">
                    <Border Width="420"
                            MaxWidth="520"
                            Padding="22"
                            CornerRadius="12"
                            Background="{DynamicResource Settings.ShellBrush}"
                            BorderBrush="{DynamicResource Settings.BorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        Background="#1F007AFF"
                                        BorderBrush="{DynamicResource Settings.AccentBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left">
                                    <Path Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Settings.AccentBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M6,1 L6,7 M6,10 L6,10.5"/>
                                </Border>
                                <TextBlock x:Name="ConfirmationTitleText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Settings.CardTitle}"
                                           FontSize="15"/>
                            </Grid>
                            <TextBlock x:Name="ConfirmationMessageText"
                                       Grid.Row="1"
                                       Margin="36,12,0,0"
                                       Foreground="{DynamicResource Settings.TextSecondaryBrush}"
                                       FontSize="12"
                                       LineHeight="19"
                                       TextWrapping="Wrap"/>
                            <StackPanel Grid.Row="2"
                                        Margin="36,20,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Style="{StaticResource Settings.FooterButton}"
                                        Click="ConfirmationCancel_Click"
                                        AutomationProperties.Name="取消当前操作">
                                    <TextBlock Text="取消"/>
                                </Button>
                                <Button x:Name="ConfirmationConfirmButton"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource Settings.PrimaryButton}"
                                        Click="ConfirmationConfirm_Click">
                                    <TextBlock x:Name="ConfirmationConfirmButtonText"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>

