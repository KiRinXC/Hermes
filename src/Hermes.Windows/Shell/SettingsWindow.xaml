                                                            <Path Fill="{DynamicResource Settings.FloatingButtonPreviewInnerBrush}" Data="M641.4 112c27.3 0 53.6 8.2 76 23.7 22.1 15.3 39 36.5 49 61.4l8.3 20.6c6.4 16 23.1 25.3 40 22.4l21.9-3.7c5.9-1 11.8-1.5 17.8-1.5 58.2 0 105.6 48 105.6 107 0 21-6 41.3-17.3 58.8-11.1 17-26.5 30.4-44.7 38.8l-19.2 8.8c-22.1 10.1-31.5 36.4-20.9 58.3l9.2 19c6.1 12.6 9.2 26.2 9.2 40.4 0 50.6-40.6 91.8-90.5 91.8-15.6 0-30.4-3.9-44-11.6l-14.7-8.3c-19.2-10.9-43.6-6-57.1 11.5l-10.3 13.4C631.5 699.1 589 720 543.3 720c-26.8 0-53.1-7.3-75.9-21.2-22.3-13.6-40.8-32.9-53.4-55.9l-6.9-12.6c-12.8-23.4-41.9-32.3-65.6-20.2l-12.8 6.5c-12 6.1-24.9 9.3-38.4 9.3-19.5 0-37.9-6.5-53.1-18.8-14.9-12.1-25.6-29-30-47.6l-4.3-18.1C198 521 179 507.2 158 508.9l-18.5 1.6c-2.3 0.2-4.2 0.3-5.9 0.3-38.4 0-69.6-31.7-69.6-70.7 0-17.8 6.5-34.7 18.3-47.8 11.7-12.9 27.4-20.9 44.4-22.5l23.4-2.3c19.9-2 35-18.9 34.7-38.9l-0.4-23.5v-0.7-1.7c0-36.6 14.1-70.9 39.7-96.7 25.5-25.7 59.3-39.8 95.2-39.8 36.5 0 70.7 14.6 96.3 41l25.8 26.6c18.7 19.3 50.8 13.9 62.3-10.3l15.8-33.5c10.9-23 27.8-42.5 49.1-56.3 21.7-14.3 46.9-21.7 72.8-21.7z"/>
