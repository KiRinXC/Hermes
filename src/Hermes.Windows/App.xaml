<Application x:Class="Hermes.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="UI/Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="UI/Themes/ComponentStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
